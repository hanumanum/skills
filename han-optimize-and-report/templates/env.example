# Shared by skills under .cursor/skills. Copy to .cursor/skills/.env and fill in.
# .env is gitignored. Leave a value empty when this repo does not use it.

# Sent as the Authorization header on every load-test request. Example: Bearer <token>
LOAD_AUTHORIZATION=

# Sent as the Cookie header on every load-test request.
LOAD_COOKIE=

# Tracing or log tool. The tool name is stored in .han-optimize.json, not here.
OBSERVABILITY_URL=
OBSERVABILITY_API_KEY=
OBSERVABILITY_ENVIRONMENT=
